# Environment Configuration
ENVIRONMENT=development

# Vault Configuration (Primary - all other secrets retrieved from Vault)
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=dev-only-token

# Fallback Environment Variables (only used if Vault is unavailable)
# Note: In production, these should be stored in Vault instead
# SECRET_KEY=your-secret-key-here-change-this-in-production
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# GEMINI_API_KEY=your-gemini-api-key-here
# DATABASE_HOST=localhost
# DATABASE_PORT=1433
# DATABASE_NAME=HackathonDB
# DATABASE_USER=sa
# DATABASE_PASSWORD=YourStrong!Passw0rd

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000